# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/civicpulse?schema=public
# Optional and required only for database-mutating integration tests. Never point this at your development database.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/civicpulse_test?schema=public

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Background jobs (disabled by default, especially for test environments)
ENABLE_BACKGROUND_JOBS=false
SLA_CHECK_INTERVAL_MS=3600000
NOTIFICATION_CHECK_INTERVAL_MS=3600000
CLEANUP_INTERVAL_MS=86400000
NOTIFICATION_RETENTION_DAYS=90
