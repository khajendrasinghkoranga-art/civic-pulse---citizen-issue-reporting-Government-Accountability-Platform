# ============================================================
# CivicPulse — Git Ignore Rules
# ============================================================

# ── Dependencies ──
node_modules/
.pnp
.pnp.js

# ── Environment Variables ──
.env
.env.*
!.env.example
!.env.local.example

# ── Build Outputs ──
dist/
build/
.next/
out/

# ── Testing ──
coverage/
*.lcov
.nyc_output/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Database ──
*.dump
*.sql.gz

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── AI Agent Configs ──
.agents/
.claude/
.cursor/
.devin/

# ── Uploads (generated at runtime) ──
uploads/
!uploads/.gitkeep

# ── Prisma ──
prisma/migrations/*.sql.bak

# ── Misc ──
scratch/
*.tsbuildinfo
next-env.d.ts